14. Now run gunicorn as daemon process using systemctl so it will run indefinitely 
             
           #sudo vim /lib/systemd/system/chatapp.service 
           
          Add below configuration => 
          [Unit] 
          Description=Chatapp Service 
          After=network.target 
          [Service] 
          User=chatapp 
          Group=chatapp 
          EnvironmentFile=/etc/chatapp/env.conf 
          WorkingDirectory=/app/fundoo 
          ExecStart=/bin/bash -c "cd /app && source venv/bin/activate && cd /app/fundoo &&              
/app/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:8000 fundoo.wsgi:application" 
          [Install] 
          WantedBy=multi-user.target 
 
       
