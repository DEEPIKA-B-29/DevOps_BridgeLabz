FROM ubuntu:20.04
 
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
 
RUN apt-get update && apt-get install -y \
    python3.8 \
    python3-pip \
    python3.8-dev \
    build-essential \
    libmysqlclient-dev \
    libssl-dev \
    pkg-config \
    git \
    zlib1g-dev \
    libjpeg-dev && \
    rm -rf /var/lib/apt/lists/*
 
WORKDIR /app
 
# Clone the repository
RUN git clone https://github.com/DEEPIKA-B-29/chatapp-modified-ubuntu-22.04.git .
 
# Install dependencies and skip gunicorn
RUN python3.8 -m pip install --upgrade pip setuptools wheel && \
    python3.8 -m pip install -r requirements.txt && \
    python3.8 -m pip install mysqlclient
 
EXPOSE 8000
 
# Chained command to handle migrations and start the dev server
# Using 0.0.0.0:8000 allows the server to be accessible from outside the container
CMD python3.8 fundoo/manage.py makemigrations && \
    python3.8 fundoo/manage.py migrate && \
    python3.8 fundoo/manage.py runserver 0.0.0.0:8000
